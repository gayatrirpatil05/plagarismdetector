# ─── SemanticEye | Environment Configuration ───────────────────────
# Copy to .env (never commit .env) or set these in your hosting dashboard.

# "production" (secure defaults) or "development" (local testing over http)
APP_ENV=production

# Must be true whenever the site is served over HTTPS (it is, in production).
# Leave unset: it defaults to true in production and false in development.
# COOKIE_SECURE=true

# Where the SQLite database is stored. On a host, mount a persistent disk here.
DATA_DIR=/data

HOST=0.0.0.0
PORT=8000

# Live Wikipedia lookups send the first few words of each checked sentence to
# en.wikipedia.org. Set to false for a fully self-contained deployment.
ENABLE_WEB_SEARCH=true

# Optional limits (defaults shown)
# SESSION_DAYS=7
# MAX_UPLOAD_MB=10
# MAX_TEXT_CHARS=100000
# ANALYZE_PER_MINUTE=10
# MAX_USER_CORPUS_DOCS=20

# Only if your frontend is served from a different origin (normally leave empty)
# ALLOWED_ORIGINS=

# ── ML models (pip install -r requirements-ml.txt; python scripts/download_models.py) ──
ENABLE_SBERT=true
ENABLE_ROBERTA=true
ENABLE_PERPLEXITY=true
PRELOAD_MODELS=true
# LM_MODEL=gpt2            # try gpt2-medium for better perplexity (slower)
# PPL_MIDPOINT=35          # tune with: python -m evaluation.eval_ai --fit

# ── Web-wide search (pick one; with none set, DuckDuckGo + Wikipedia are used) ──
# SEARCH_PROVIDER=auto
# BRAVE_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# SERPAPI_KEY=
